# ==============================================================================
# DevPilot AI - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="DevPilot AI"
API_V1_STR=/api

# Server Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & Authentication
# Generate a secure secret: openssl rand -hex 32
SECRET_KEY=devpilot-insecure-secret-key-change-in-production-0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: SQLite for immediate development. Production: PostgreSQL with pgvector
DATABASE_URL=sqlite:///./devpilot.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devpilot

# Redis / Background Worker
REDIS_URL=redis://localhost:6379/0

# GitHub Integration (OAuth or GitHub App)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER=openai
# Options: openai, gemini, groq, anthropic, ollama
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-pro
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Deep Learning & Code Embeddings
EMBEDDING_MODEL_NAME=microsoft/codebert-base
DEFECT_MODEL_PATH=ai_engine/ml/checkpoints/codebert_defect.pt
DEPLOYMENT_RISK_MODEL_PATH=ai_engine/ml/checkpoints/deployment_risk.pkl

# Execution Sandbox
DOCKER_SANDBOX_NETWORK_DISABLED=true
DOCKER_SANDBOX_CPU_LIMIT=1.0
DOCKER_SANDBOX_MEMORY_LIMIT=512m
DOCKER_SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_TEMP_DIR=./execution/sandbox/workspaces

# Monitoring & Prometheus
PROMETHEUS_METRICS_ENABLED=true
